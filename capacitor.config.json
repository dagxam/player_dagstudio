{
  "appId": "ru.dagstudio.player",
  "appName": "DAGSTUDIO PLAYER",
  "webDir": "www",
  "backgroundColor": "#0b0b0b",
  "appendUserAgent": " DAGSTUDIO-NATIVE/1.0",
  "server": {
    "hostname": "localhost",
    "androidScheme": "https",
    "iosScheme": "capacitor"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "CapacitorUpdater": {
      "autoUpdate": "off",
      "resetWhenUpdate": true,
      "autoDeleteFailed": true,
      "autoDeletePrevious": true
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
